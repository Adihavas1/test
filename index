
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>F28 Gas Tracker</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    table { border-collapse: collapse; width: 100%; margin-top: 20px; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background-color: #0078d4; color: white; }
    input, select, button { padding: 8px; margin: 4px; }
  </style>
</head>
<body>
  <h1>🔧 F28 Gas Tracker</h1>

  <!-- Input Form -->
  <div>
    <input id="gasName" placeholder="Gas Name" />
    <input id="location" placeholder="Location" />
    <select id="status">
      <option>Pending</option>
      <option>Replaced</option>
      <option>In Progress</option>
    </select>
    <select id="addedBy">
      <option value="">-- Added By --</option>
      <!-- Team names will be loaded here -->
    </select>
    <button onclick="addEntry()">💾 Save Entry</button>
  </div>

  <!-- Data Table -->
  <table>
    <thead>
      <tr><th>Gas</th><th>Location</th><th>Status</th><th>Added By</th><th>Date</th></tr>
    </thead>
    <tbody id="tableBody"></tbody>
  </table>

  <script>
    // ✅ Replace with YOUR Supabase credentials
    const SUPABASE_URL = 'https://mpmtjagqllzfzcwzjqez.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1wbXRqYWdxbGx6Znpjd3pqcWV6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc5NzQ2OTQsImV4cCI6MjA5MzU1MDY5NH0.pEK6DQIcipIDdpvcikb2xjq-_LYKDyk5c8E9UUFJEQU';
    const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    // Load entries on page load
    async function loadEntries() {
      const { data, error } = await supabase
        .from('gas_entries')
        .select('*')
        .order('created_at', { ascending: false });

      const tbody = document.getElementById('tableBody');
      tbody.innerHTML = '';
      if (data) {
        data.forEach(row => {
          tbody.innerHTML += `<tr>
            <td>${row.gas_name}</td>
            <td>${row.location}</td>
            <td>${row.status}</td>
            <td>${row.added_by}</td>
            <td>${new Date(row.created_at).toLocaleDateString()}</td>
          </tr>`;
        });
      }
    }

    // Add new entry
    async function addEntry() {
      const { error } = await supabase.from('gas_entries').insert({
        gas_name: document.getElementById('gasName').value,
        location: document.getElementById('location').value,
        status: document.getElementById('status').value,
        added_by: document.getElementById('addedBy').value,
      });
      if (error) alert('Error: ' + error.message);
      else { loadEntries(); alert('Entry saved!'); }
    }

    loadEntries();
  </script>
</body>
</html>
